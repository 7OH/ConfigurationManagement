<Window x:Class="Configuration_Management.ConfigUpdateLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Configuration_Management.Localization"
        Title="{loc:Loc Updates.EditConfig}"
        Icon="{StaticResource AppIcon}"
        Width="620" Height="600"
        MinHeight="520" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#166534"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold" Text="{loc:Loc Updates.EditConfig}"/>
        <TextBlock Grid.Row="1" x:Name="BaseNameText" FontSize="13" Margin="0,6,0,0" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <StackPanel>
                <!-- Типовая конфигурация -->
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Updates.Name}"/>
                <ComboBox x:Name="ConfigCombo" SelectionChanged="OnConfigSelectionChanged" Padding="10,7"
                          DisplayMemberPath="Name" VerticalContentAlignment="Center"/>

                <!-- Редакция -->
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Updates.SelectEdition}"/>
                <ComboBox x:Name="EditionCombo" SelectionChanged="OnEditionSelectionChanged" Padding="10,7"
                          DisplayMemberPath="Name" VerticalContentAlignment="Center"/>

                <!-- Режим URL: авто / вручную -->
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Updates.Url}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="AutoUrlRadio" GroupName="UrlMode" Content="{loc:Loc Updates.UrlAuto}"
                                 VerticalContentAlignment="Center" Margin="0,0,20,0" Cursor="Hand"
                                 Checked="OnUrlModeChanged"/>
                    <RadioButton x:Name="ManualUrlRadio" GroupName="UrlMode" Content="{loc:Loc Updates.UrlManual}"
                                 VerticalContentAlignment="Center" Cursor="Hand"
                                 Checked="OnUrlModeChanged"/>
                </StackPanel>

                <TextBox x:Name="UrlBox" Padding="10,7" FontSize="12" VerticalContentAlignment="Center"
                         IsReadOnly="True" TextWrapping="Wrap"
                         materialDesign:HintAssist.Hint="{loc:Loc Updates.Url}"/>

                <!-- Определить версию -->
                <Button x:Name="DefineVersionButton" Height="36" Margin="0,14,0,0" HorizontalAlignment="Left"
                        Style="{StaticResource OutlineButtonStyle}" Click="OnDefineVersionClick">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="MagnifyScan" Width="16" Height="16"/>
                        <TextBlock Text="{loc:Loc Updates.DefineVersion}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock x:Name="CurrentConfigText" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="ResultText" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="#16A34A"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Нижняя панель: Сохранить / Отмена -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Width="150" Height="36" Margin="0,0,10,0"
                        Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="OnSaveClick">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Foreground="White"/>
                        <TextBlock Text="{loc:Loc Updates.Save}" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button Width="120" Height="36" Style="{StaticResource OutlineButtonStyle}" IsCancel="True"
                        Click="OnCancelClick">
                    <TextBlock Text="{loc:Loc Updates.Cancel}" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>