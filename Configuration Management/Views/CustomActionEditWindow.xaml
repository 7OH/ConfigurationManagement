<Window x:Class="Configuration_Management.CustomActionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Configuration_Management.Localization"
        Title="Пользовательское действие"
        Icon="{StaticResource AppIcon}"
        Width="680" Height="740" MinWidth="600" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Темизация окна редактирования действия (функция 7): стили из LightTheme/DarkTheme,
             как у окна редактирования сценария (ScriptScenarioEditWindow, issue #291). -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource ModernMaterialCheckBox}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItem}"/>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="Сохранить" Width="100" Margin="0,0,8,0" Padding="6,4" IsDefault="True" Click="Ok_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="90" Padding="6,4" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="NameLabel" Text="Наименование" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,10"/>

                <TextBlock x:Name="CommandLabel" Text="Команда (скрипт)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="CommandBox" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="140"
                         VerticalScrollBarVisibility="Auto" Padding="4" Margin="0,0,0,4"
                         TextChanged="OnTextChanged"/>
                <TextBlock x:Name="CommandHint" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="2,0,0,10"/>

                <TextBlock x:Name="ScopeLabel" Text="Область применения" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="ScopeCombo" SelectedValuePath="Key" DisplayMemberPath="Value"
                          HorizontalAlignment="Left" MinWidth="260" Margin="0,0,0,10"
                          SelectionChanged="OnSelectionChanged"/>

                <TextBlock x:Name="ShellLabel" Text="Интерпретатор" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="ShellCombo" SelectedValuePath="Key" DisplayMemberPath="Value"
                          HorizontalAlignment="Left" MinWidth="260" Margin="0,0,0,10"
                          SelectionChanged="OnSelectionChanged"/>

                <CheckBox x:Name="SupportsBatchCheckBox" Content="Показывать для выделенных (N) баз"
                          IsChecked="{Binding SupportsBatch, Mode=TwoWay}" Margin="0,0,0,6"/>
                <CheckBox x:Name="RunWithoutConfirmCheckBox" Content="Выполнять без подтверждения"
                          IsChecked="{Binding RunWithoutConfirm, Mode=TwoWay}" Margin="0,0,0,6"/>
                <CheckBox x:Name="EscapeValuesCheckBox" Content="Экранировать подставляемые значения для shell"
                          IsChecked="{Binding EscapeValues, Mode=TwoWay}" Margin="0,0,0,10"/>

                <TextBlock x:Name="TimeoutLabel" Text="Таймаут ожидания, сек" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TimeoutBox" Width="100" HorizontalAlignment="Left" Padding="4" Margin="0,0,0,10"
                         TextChanged="OnTextChanged"/>

                <TextBlock x:Name="HotkeyLabel" Text="Горячая клавиша (необязательно)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="HotkeyBox" Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4" Margin="0,0,0,10" TextChanged="OnTextChanged"/>

                <TextBlock x:Name="WorkingDirectoryLabel" Text="Рабочая папка (пусто — каталог приложения)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="WorkingDirectoryBox" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4" Margin="0,0,0,10" TextChanged="OnTextChanged"/>

                <TextBlock x:Name="TokensLabel" Text="Подстановки" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <!-- Двойной клик по токену вставляет его в позицию курсора поля команды
                     (механизм как у сценариев, issue #308): в списке «%token% — описание». -->
                <ListBox x:Name="TokensList" Height="120" Margin="0,0,0,4" MouseDoubleClick="TokensList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Token}" FontWeight="SemiBold"/>
                                <TextBlock Text=" — "/>
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="TokensHint" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="2,0,0,10"/>

                <TextBlock x:Name="ExampleBaseLabel" Text="База для примера" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <!-- Живое превью командной строки строится по выбранной базе (как в
                     ScriptScenarioEditWindow / ScriptPickWindow): имя вместо ToString(). -->
                <ComboBox x:Name="ExampleBaseCombo" HorizontalAlignment="Left" MinWidth="260" Margin="0,0,0,4" SelectionChanged="OnSelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="PreviewLabel" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="2,0,0,2"/>
                <TextBox x:Name="PreviewBox" IsReadOnly="True" TextWrapping="Wrap" Padding="4" Margin="0,0,0,10"
                         Background="{DynamicResource CardBackgroundBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>