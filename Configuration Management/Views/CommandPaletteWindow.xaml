<Window x:Class="Configuration_Management.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Configuration_Management.Localization"
        Title="{loc:Loc Palette.Title}"
        Width="560" SizeToContent="Height"
        MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Background="{DynamicResource ContentBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ListBox" BasedOn="{StaticResource ModernListBox}"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поисковая строка: Enter — выполнить, Shift+Enter — Конфигуратор (для баз), Esc — закрыть -->
        <TextBox x:Name="SearchBox" Grid.Row="0" Padding="10,8" FontSize="14"
                 KeyDown="OnSearchBox_KeyDown"
                 TextChanged="OnSearchBox_TextChanged"/>

        <ListBox x:Name="ItemList" Grid.Row="1" MaxHeight="380" Margin="0,8,0,0"
                 BorderThickness="0" Background="Transparent"
                 SelectionChanged="OnItemList_SelectionChanged"
                 MouseDoubleClick="OnItemList_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,1,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Hint}" FontSize="11" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="HintText" Grid.Row="2" Margin="2,8,0,2" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{loc:Loc Palette.Hint}"/>
    </Grid>
</Window>
